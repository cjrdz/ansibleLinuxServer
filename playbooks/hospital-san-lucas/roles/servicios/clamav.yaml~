- name: ClamAV
  hosts: servidores_administrativos
  become: yes
  vars:
    scan_directory: "/var/lib/dicom_data"
    quarantine_dir: "/var/log/clamav/quarantine"

  tasks:
    - name: Instalar ClamAV y sus dependencias
      package:
        name: [clamav, clamav-daemon, freshclam]
        state: present

    - name: Asegurar que el directorio de cuarentena existe
      file:
        path: "{{ quarantine_dir }}"
        state: directory
        owner: clamav
        group: clamav
        mode: '0750'

    # 1. Definir el SERVICIO (Qué se va a ejecutar)
    - name: Crear archivo de servicio para escaneo de ClamAV
      copy:
        dest: /etc/systemd/system/clamav-scan.service
        content: |
          [Unit]
          Description=Escaneo diario de antivirus
          After=network.target

          [Service]
          Type=oneshot
          User=clamav
          ExecStart=/usr/bin/clamscan -r {{ scan_directory }} --move={{ quarantine_dir }}
          
          # Endurecimiento del propio proceso de escaneo
          PrivateTmp=true
          ProtectSystem=full
          NoNewPrivileges=true
          CapabilityBoundingSet=CAP_DAC_READ_SEARCH
          
          # Gestión de recursos para no afectar servicios clínicos
          CPUWeight=20
          IOWeight=20

    # 2. Temporizador
    - name: Crear archivo de timer para el escaneo
      copy:
        dest: /etc/systemd/system/clamav-scan.timer
        content: |
          [Unit]
          Description=Ejecutar escaneo de ClamAV diariamente a la cero horas.

          [Timer]
          OnCalendar=*-*-* 00:00:00
          RandomizedDelaySec=15m
          Persistent=true
          Unit=clamav-scan.service

          [Install]
          WantedBy=timers.target

    - name: Recargar demonio, habilitar y arrancar el temporizador
      systemd:
        name: clamav-scan.timer
        state: started
        enabled: yes
        daemon_reload: yes

    - name: Actualización de firmas con Freshclam
      systemd:
        name: clamav-freshclam
        state: started
        enabled: yes
