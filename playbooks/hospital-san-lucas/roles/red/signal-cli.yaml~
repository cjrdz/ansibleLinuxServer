- name: Instalación Dinámica de Signal-cli (Última Versión)
  hosts: servidor_gestion
  become: yes
  vars:
    install_path: "/opt"
    binary_path: "/usr/local/bin"

  tasks:
    - name: Consultar la última versión disponible en GitHub
      uri:
        url: https://api.github.com/repos/AsamK/signal-cli/releases/latest
        return_content: yes
      register: signal_latest

    - name: Extraer URL de descarga del tar.gz
      set_fact:
        signal_download_url: "{{ signal_latest.json.assets | selectattr('name', 'search', 'tar.gz$') | map(attribute='browser_download_url') | first }}"
        signal_version_name: "{{ signal_latest.json.tag_name | regex_replace('^v', '') }}"

    - name: Instalar dependencias necesarias (JRE y utilidades)
      package:
        name: [default-jre, wget, tar]
        state: present

    - name: Descargar y extraer la última versión de Signal-cli
      unarchive:
        src: "{{ signal_download_url }}"
        dest: "{{ install_path }}"
        remote_src: yes
        creates: "{{ install_path }}/signal-cli-{{ signal_version_name }}"

    - name: Crear enlace simbólico en /usr/local/bin para disponibilidad global
      file:
        src: "{{ install_path }}/signal-cli-{{ signal_version_name }}/bin/signal-cli"
        dest: "{{ binary_path }}/signal-cli"
        state: link

    - name: Verificar instalación y versión
      command: signal-cli --version
      register: signal_check
      changed_when: false

    - name: Mostrar versión instalada
      debug:
        msg: "Se ha instalado correctamente la versión {{ signal_check.stdout }} en /usr/local/bin"
