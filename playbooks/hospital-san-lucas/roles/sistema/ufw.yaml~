- name: ufw
  hosts: servidores_clinicos
  become: yes
  tasks:
    # Configuración de cortafuegos
    - name: Configurar política por defecto
      ufw:
        state: enabled
        policy: deny
        direction: incoming

    - name: Permitir servicios esenciales
      ufw:
        rule: allow
        port: "{{ item }}"
        proto: tcp
      loop: [ '22', '443' ]
