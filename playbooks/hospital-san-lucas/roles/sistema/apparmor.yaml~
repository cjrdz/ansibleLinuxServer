- name: Configuración de Endurecimiento AppArmor
  hosts: servidores_debian_ubuntults
  become: yes
  tasks:
    - name: Asegurar que AppArmor esté habilitado en el arranque
      lineinfile:
        path: /etc/default/grub
        regexp: '^GRUB_CMDLINE_LINUX_DEFAULT='
        line: 'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash apparmor=1 security=apparmor"'
      notify: Actualizar Grub

    - name: Poner perfiles de servicios críticos en modo "Enforce"
      shell: aa-enforce /etc/apparmor.d/*
      
  handlers:
    - name: Actualizar Grub
      command: update-grub
