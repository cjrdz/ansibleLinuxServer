# ============================================================================
# Ansible Environment Variables
# ============================================================================
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
#   source .env
# ============================================================================

# Server IP Addresses (REQUIRED)
# These are the actual IP addresses of your servers
# ANSIBLE_HOST_MASTER= Add your Instance Ip here
# ANSIBLE_HOST_NODE1= Add your Instance Ip here

# SSH Private Key Path
# ANSIBLE_SSH_KEY_PATH_MASTER= Add your Private Keys path here
# ANSIBLE_SSH_KEY_PATH_NODE1= Add your Private Keys path here
